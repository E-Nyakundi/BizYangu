# BizYangu — Production environment
#
# Copy this to `.env.production` (same directory as docker-compose.prod.yml)
# and fill in the TODO values. SECRET_KEY, DB_PASSWORD, and ADMIN_URL_PATH
# below are already generated for you — don't reuse them anywhere else and
# don't commit the real .env.production file to git.

# ── Django core ──
SECRET_KEY=W8@jXx5os@qp77QCwhJ&KF41YUzYp418_XScSpB16*rAkku5TT
DEBUG=False
DJANGO_SETTINGS_MODULE=bizyangu.settings.production

# TODO: your real domain(s) — the Vercel frontend domain + your API subdomain.
# No scheme, comma-separated.
ALLOWED_HOSTS=api.biasharasystems.co.ke
CORS_ALLOWED_ORIGINS=https://TODO-your-vercel-domain.vercel.app,https://biasharasystems.co.ke
CSRF_TRUSTED_ORIGINS=https://api.biasharasystems.co.ke

# ── Database (matches docker-compose.prod.yml's postgres service) ──
DB_NAME=bizyangu_prod
DB_USER=bizyangu
DB_PASSWORD=8Iz62zUKoUTeOqGXyQijhZan

# ── Redis (in-cluster, set by docker-compose.prod.yml — leave as is) ──
# REDIS_URL is already set to redis://redis:6379/0 by the compose file's
# `environment:` block on each service. Don't duplicate it here.

# ── Africa's Talking (OTP + bulk SMS) — TODO: your live app credentials ──
AT_USERNAME=TODO-your-live-at-username
AT_API_KEY=TODO-your-live-at-api-key
# Leave blank until your alphanumeric Sender ID (e.g. BizYangu) is approved.
AT_SENDER_ID=
# MUST be False in production — True lets anyone log in with OTP "000000".
DEV_OTP_BYPASS=False

# ── M-Pesa Daraja — TODO: your production app credentials, not sandbox ──
MPESA_ENV=production
MPESA_CONSUMER_KEY=TODO-your-production-consumer-key
MPESA_CONSUMER_SECRET=TODO-your-production-consumer-secret
MPESA_SHORTCODE=TODO-your-real-shortcode
MPESA_PASSKEY=TODO-your-production-passkey
MPESA_CALLBACK_URL=https://api.biasharasystems.co.ke/api/v1/payments/mpesa/callback/
# Decide deliberately — leaving disabled is a reasonable pilot-stage tradeoff,
# but Safaricom does support allowlisting the callback endpoint by IP.
MPESA_CALLBACK_IP_ALLOWLIST_DISABLED=True

# ── Admin panel — random slug so /admin/ (the first thing every bot scans)
#    doesn't exist. Already generated, but keep it secret.
ADMIN_URL_PATH=lbrekpw8-manage-6evr/

# ── Optional: leave blank to disable, no crash either way ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production
FCM_SERVICE_ACCOUNT_JSON=
