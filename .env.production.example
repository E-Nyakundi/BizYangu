# BizYangu — Production environment
#
# Reconstructed from the actual .env.production running on the VM
# (bizyangu-vnic) as of 2026-09-22 — the repo previously had no
# production template at all, only .env.example (local dev). Real
# values below are replaced with TODO/placeholder text; only key
# *names*, defaults, and structure are meant to match the VM exactly.
#
# Copy to `.env.production` (same directory as docker-compose.prod.yml)
# and fill in the TODO values. Do not commit the real file to git.

# ── Django core ──
SECRET_KEY=TODO-generate-a-real-secret-key
DEBUG=False
# NOTE: baked into Dockerfile.prod as a build-time ENV already, so this
# line is redundant on the VM — kept here only so `docker compose config`
# and anyone reading this file see the same value the image already has.
# If Dockerfile.prod's ENV line is ever removed, THIS becomes load-bearing.
DJANGO_SETTINGS_MODULE=bizyangu.settings.production

# TODO: your real domain(s) — the Vercel frontend domain + your API subdomain.
# No scheme, comma-separated.
ALLOWED_HOSTS=api.yourdomain.example
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,https://yourdomain.example,https://app.yourdomain.example

# Now genuinely required in production (fixed 2026-09-22 — previously
# set on the VM but silently unread; production.py now calls
# config('CSRF_TRUSTED_ORIGINS') with no default, same as
# ALLOWED_HOSTS/FRONTEND_URL below, so a deploy missing this fails
# loudly at startup instead of silently omitting CSRF protection for
# these origins). Usually the same values as CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.example

# Used to build absolute links back to the frontend (currently only the
# staff invite URL). Required — Django will not start without it.
FRONTEND_URL=https://app.yourdomain.example

# ── Database (matches docker-compose.prod.yml's postgres service) ──
DB_NAME=bizyangu_prod
DB_USER=bizyangu
DB_PASSWORD=TODO-your-real-db-password

# ── Redis (in-cluster, set by docker-compose.prod.yml — leave as is) ──
# REDIS_URL is already set to redis://redis:6379/0 by the compose file's
# `environment:` block on each service. Don't duplicate it here.

# ── Africa's Talking (OTP + bulk SMS) — TODO: your live app credentials ──
AT_USERNAME=TODO-your-live-at-username
AT_API_KEY=TODO-your-live-at-api-key
# Leave blank until your alphanumeric Sender ID (e.g. BizYangu) is approved.
AT_SENDER_ID=
# MUST be False in production — True lets anyone log in with OTP "000000".
DEV_OTP_BYPASS=False

# ── M-Pesa Daraja — TODO: your production app credentials, not sandbox ──
MPESA_ENV=production
MPESA_CONSUMER_KEY=TODO-your-production-consumer-key
MPESA_CONSUMER_SECRET=TODO-your-production-consumer-secret
MPESA_SHORTCODE=TODO-your-real-shortcode
MPESA_PASSKEY=TODO-your-production-passkey
MPESA_CALLBACK_URL=https://api.yourdomain.example/api/v1/payments/mpesa/callback/

# M-Pesa Daraja — COMPANY shortcode. Separate Daraja app from the sales
# credentials above — this one is BizYangu's own subscription revenue
# from business owners, not money businesses receive from their own
# customers. Register the subscription callback URL below (not
# mpesa/callback/) in this app's Daraja portal settings.
MPESA_COMPANY_ENV=production
MPESA_COMPANY_CONSUMER_KEY=TODO-your-company-production-consumer-key
MPESA_COMPANY_CONSUMER_SECRET=TODO-your-company-production-consumer-secret
MPESA_COMPANY_SHORTCODE=TODO-your-company-real-shortcode
MPESA_COMPANY_PASSKEY=TODO-your-company-production-passkey
MPESA_COMPANY_CALLBACK_URL=https://api.yourdomain.example/api/v1/payments/mpesa/subscription/callback/

# Encrypts BusinessMpesaCredentials.consumer_secret/passkey at rest — each
# business's own Daraja app credentials, once they set one up. Generate
# ONE value and never regenerate it without re-encrypting existing rows
# (rotating this key makes existing rows undecryptable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MPESA_CREDENTIALS_ENCRYPTION_KEY=TODO-generate-with-the-command-above
# Decide deliberately — leaving disabled is a reasonable pilot-stage
# tradeoff, but Safaricom does support allowlisting the callback endpoint
# by IP.
MPESA_CALLBACK_IP_ALLOWLIST_DISABLED=True

# ── Admin panel — random slug so /admin/ (the first thing every bot
#    scans) doesn't exist. Generate your own, keep it secret.
#    e.g. ADMIN_URL_PATH=xk7-manage-2f9/
ADMIN_URL_PATH=TODO-generate-a-random-slug/

# ── Optional: leave blank to disable, no crash either way ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production
FCM_SERVICE_ACCOUNT_JSON=

# ── Google Sign-In — OAuth 2.0 client IDs from Google Cloud Console.
# Comma-separated: web client ID, Android client ID(s) (debug + release
# both coexist permanently — see BizYangu_Mobile_Progress_Log.md Phase 1).
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# ── Google Programmable Search (barcode resolution fallback) — optional,
# blank = today's UNRESOLVED-only behaviour, no crash either way.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# ── Mobiwave (SMS fallback provider) — optional, blank = skipped in
# SMS_PROVIDER_PRIORITY, falls through to the next configured provider.
MOBIWAVE_API_KEY=
MOBIWAVE_SENDER_ID=
