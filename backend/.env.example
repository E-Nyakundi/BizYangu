SECRET_KEY=django-insecure-replace-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1, https://api.trycloudflare.com

# Database
DB_NAME=bidness
DB_USER=lewis
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000, https://api.trycloudflare.com

# Africa's Talking (OTP)
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
# Leave blank until a Kenyan Sender ID is approved (see BizYangu_Path_to_Pilot.md
# for the registration process/cost/timeline). Blank = AT's shared default sender.
AT_SENDER_ID=
# False = real OTP flow via Africa's Talking. True = accepts fixed '000000',
# no SMS sent at all — dev/testing only, must be False before pilot.
DEV_OTP_BYPASS=False

# Google Sign-In — OAuth 2.0 client IDs from Google Cloud Console.
# Comma-separated: one for the web app, one for the Android/Capacitor app
# (they're different client IDs even though both hit this same backend).
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# M-Pesa Daraja
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://api.trycloudflare.com/api/v1/payments/mpesa/callback/

# Company shortcode (subscription billing) — Daraja sandbox default
# shortcode/passkey below are Safaricom's shared public sandbox
# test credentials, fine for local dev; get your own consumer
# key/secret from a sandbox Daraja app either way.
MPESA_COMPANY_CONSUMER_KEY=your-company-consumer-key
MPESA_COMPANY_CONSUMER_SECRET=your-company-consumer-secret
MPESA_COMPANY_SHORTCODE=174379
MPESA_COMPANY_PASSKEY=your-company-passkey
MPESA_COMPANY_CALLBACK_URL=https://api.trycloudflare.com/api/v1/payments/mpesa/subscription/callback/

# Any valid Fernet key works for local dev — generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MPESA_CREDENTIALS_ENCRYPTION_KEY=generate-a-local-dev-key-with-the-command-above

# ngrok
NGROK_DOMAIN=your-static-ngrok-domain.ngrok-free.app

# Firebase Cloud Messaging (low-stock push notifications)
# Paste the full service-account JSON as ONE line. Leave empty to
# disable push — the app degrades gracefully (logs only, no crash).
FCM_SERVICE_ACCOUNT_JSON=

# Sentry (production error tracking). Leave empty to disable — nothing
# crashes if unset, errors just aren't reported anywhere.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production

# Admin panel path — set this to a long random slug in production so
# /admin/ (the first thing every scanner tries) doesn't exist.
# e.g. ADMIN_URL_PATH=xk7-manage-2f9/
ADMIN_URL_PATH=admin/
